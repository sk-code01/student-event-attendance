# Copy this file to backend/.env and fill in real values.
# NEVER commit the real .env file — it is listed in .gitignore.
#
# Every value below is read by backend/config/settings.py via python-decouple.
# Anything that would be a security defect in production (a fallback secret
# key, a wildcard host, a wildcard CORS origin) makes the app refuse to start
# when DJANGO_DEBUG=False, rather than starting up misconfigured.

# ---- Django core ----
# Generate a real one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# Required in production: with DJANGO_DEBUG=False the development fallback is
# rejected at startup.
DJANGO_SECRET_KEY=change-me-to-a-random-secret

# True only for local development. Production MUST set this to False.
DJANGO_DEBUG=True

# Comma-separated. A wildcard is rejected when DJANGO_DEBUG=False.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database (NeonDB PostgreSQL) — REQUIRED ----
# Paste the connection string from your Neon project dashboard, e.g.:
#   postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/dbname?sslmode=require
# There is no SQLite fallback: PostgreSQL/Neon is the only supported database,
# in development as well as production. The app refuses to start without this.
DATABASE_URL=

# Seconds a database connection is kept alive between requests. Neon's pooler
# counts idle sessions, so keep this modest.
DB_CONN_MAX_AGE=60

# ---- JWT ----
# These are the authoritative session limits: the API validates them on every
# request, whatever the browser believes.
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# ---- Client idle timeout ----
# How long a signed-in user may be idle before the Angular application ends the
# session and returns them to the login page.
#
# This one is NOT read from here. Angular resolves its configuration at build
# time, so the value lives in frontend/src/environments/environment.ts (and
# environment.prod.ts) as `sessionInactivityTimeoutMinutes`. It is named here
# so that anyone tuning session behaviour finds both halves in one place.
#
#   SESSION_INACTIVITY_TIMEOUT_MINUTES=30  ->  environment.ts
#
# The browser timer is a convenience for the user, not a security boundary:
# a session is only truly over when the token expires or is blacklisted, which
# is what the two JWT settings above govern.

# ---- Institution timezone ----
# Used for every "current date" business decision (e.g. registration window
# checks, the event-date rule for live capture). Timestamps are always stored
# in UTC; this only affects which calendar day "today" resolves to.
APP_TIMEZONE=Asia/Kolkata

# ---- CORS / CSRF ----
# Comma-separated list of the exact browser origins the Angular app is served
# from. Wildcards are rejected when DJANGO_DEBUG=False; production values must
# be https:// because the live-capture workflow requires a secure context.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Origins trusted for Django admin / DRF browsable-API form posts. Defaults to
# CORS_ALLOWED_ORIGINS; set it only when the admin is served from a different
# hostname than the API.
# CSRF_TRUSTED_ORIGINS=https://events.example.edu

# ---- HTTPS (production) ----
# Leave unset to keep the secure defaults. Set DJANGO_SECURE_SSL_REDIRECT=False
# only if something in front of Django already redirects http->https.
# DJANGO_SECURE_SSL_REDIRECT=True
# Set to False when Django terminates TLS itself instead of sitting behind a
# reverse proxy that sets X-Forwarded-Proto.
# DJANGO_TRUST_PROXY_SSL_HEADER=True

# ---- Live participation capture thresholds ----
# A capture whose reported GPS accuracy is worse (larger) than this is
# rejected by the backend.
MAX_GPS_ACCURACY_METERS=50
# Distance from the venue past which a capture is flagged for the verifier.
# Warning only — it never blocks submission.
VENUE_WARNING_DISTANCE_METERS=200
# Maximum accepted size of a single capture image, in bytes (8 MB).
MAX_CAPTURE_FILE_SIZE=8388608

# ---- Logging ----
DJANGO_LOG_LEVEL=INFO
# Opt-in rotating file logs (application.log / security.log / error.log).
# Under systemd or Docker, prefer leaving this False and letting the
# supervisor capture stdout.
DJANGO_LOG_TO_FILE=False
# DJANGO_LOG_DIR=/var/log/smart-student-events

# ---- Frontend (frontend/src/environments) ----
# Not read by Django. The Angular app compiles its API base URL in at build
# time: src/environments/environment.ts for `ng serve`, environment.prod.ts
# for `ng build` (which uses the relative '/api/v1', assuming the reverse
# proxy serves the app and API from one origin).
API_BASE_URL=http://localhost:8000/api/v1
